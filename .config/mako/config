# =============================================================================
# Mako Notification Daemon Configuration
# Catppuccin Mocha Glassmorphic Theme with 10s Dismiss Timeout
# =============================================================================

# Core Behavior
default-timeout=10000
ignore-timeout=0
history=1
max-history=500
max-visible=5
sort=+time

# Mouse Bindings
on-button-left=invoke-default-action
on-button-right=dismiss
on-button-middle=dismiss-all

# Geometry & Positioning
width=380
height=160
margin=12,12
padding=14,18
border-size=2
border-radius=14
anchor=top-right
layer=overlay

# Catppuccin Mocha Colors
background-color=#eff1f5e6
text-color=#4c4f69
border-color=#8839ef
progress-color=over #ccd0da

# Typography & Icons
font=JetBrainsMono Nerd Font 10
icons=1
max-icon-size=48
icon-border-radius=8
markup=1
actions=1
format=<b>%s</b>\n%b

# Urgency Overrides
[urgency=low]
border-color=#1e66f5
default-timeout=8000

[urgency=normal]
border-color=#8839ef
default-timeout=10000

[urgency=critical]
border-color=#d20f39
text-color=#d20f39
default-timeout=0

[mode=dnd]
invisible=1

# OSD & Transient Rules (Do not store in notification history)
[category=osd]
history=0

[app-name=VolumeControl]
history=0

[app-name=BrightnessControl]
history=0


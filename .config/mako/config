# =============================================================================
# Mako Notification Daemon Configuration
# Catppuccin Mocha Glassmorphic Theme with 10s Dismiss Timeout
# =============================================================================

# Core Behavior
default-timeout=10000
ignore-timeout=0
history=1
max-history=500
max-visible=5
sort=+time

# Mouse Bindings
on-button-left=invoke-default-action
on-button-right=dismiss
on-button-middle=dismiss-all

# Geometry & Positioning
width=380
height=160
margin=12,12
padding=14,18
border-size=2
border-radius=14
anchor=top-right
layer=overlay

# Catppuccin Mocha Colors
background-color=#fbf1c7e6
text-color=#3c3836
border-color=#af3a03
progress-color=over #d5c4a1

# Typography & Icons
font=JetBrainsMono Nerd Font 10
icons=1
max-icon-size=48
icon-border-radius=8
markup=1
actions=1
format=<b>%s</b>\n%b

# Urgency Overrides
[urgency=low]
border-color=#076678
default-timeout=8000

[urgency=normal]
border-color=#af3a03
default-timeout=10000

[urgency=critical]
border-color=#9d0006
text-color=#9d0006
default-timeout=0

[mode=dnd]
invisible=1

# OSD & Transient Rules (Do not store in notification history)
[category=osd]
history=0

[app-name=VolumeControl]
history=0

[app-name=BrightnessControl]
history=0

# Multi-Display Active Screen Targeting (dynamically selected via makoctl mode)
[mode=output-eDP-1]
output=eDP-1

[mode=output-eDP-2]
output=eDP-2

[mode=output-HDMI-A-1]
output=HDMI-A-1

[mode=output-HDMI-A-2]
output=HDMI-A-2

[mode=output-HDMI-A-3]
output=HDMI-A-3

[mode=output-DP-1]
output=DP-1

[mode=output-DP-2]
output=DP-2

[mode=output-DP-3]
output=DP-3

[mode=output-DP-4]
output=DP-4

[mode=output-DP-5]
output=DP-5

[mode=output-DVI-D-1]
output=DVI-D-1

[mode=output-VGA-1]
output=VGA-1

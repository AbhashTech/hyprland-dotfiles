// =============================================================================
// Zellij Terminal Multiplexer Configuration - Catppuccin Mocha
// =============================================================================

theme "catppuccin-mocha"
default_layout "compact"
mouse_mode true
copy_on_select true
pane_frames false
simplified_ui false

themes {
    catppuccin-mocha {
        bg "#585b70"
        fg "#cdd6f4"
        red "#f38ba8"
        green "#a6e3a1"
        blue "#89b4fa"
        yellow "#f9e2af"
        magenta "#cba6f7"
        orange "#fab387"
        cyan "#89dceb"
        black "#181825"
        white "#cdd6f4"
    }
}

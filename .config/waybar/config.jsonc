{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 6,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "margin-bottom": 0,
    "exclusive": true,
    "passthrough": false,
    "reload_style_on_change": true,

    // Modules Layout
    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "hyprland/window",
        "mpris"
    ],
    "modules-center": [
        "clock",
        "hyprland/language"
    ],
    "modules-right": [
        "group/tray-notif",
        "group/status",
        "custom/stats",
        "custom/power"
    ],

    // ==========================================
    // Left Modules
    // ==========================================
    "custom/launcher": {
        "format": "󰣇",
        "tooltip": true,
        "tooltip-format": "Applications (Super+R)",
        "on-click": "bash /home/kunal/.config/hypr/scripts/fuzzel_launcher.sh",
        "on-click-right": "/home/kunal/.config/waybar/scripts/power-menu.sh"
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "all-outputs": true,
        "persistent-workspaces": {
            "*": [1, 2, 3, 4]
        },
        "sort-by-number": true,
        "active-only": false
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 30,
        "separate-outputs": true,
        "rewrite": {
            "": "󰖲 Desktop",
            "(.*) — Mozilla Firefox": "󰈹 $1",
            "(.*) - Kitty": "󰞷 $1",
            "(.*) - Dolphin": "󰉋 $1",
            "(.*) - Visual Studio Code": "󰨞 $1"
        }
    },

    "mpris": {
        "format": "{player_icon}  {dynamic}",
        "format-paused": "{status_icon}  <i>{dynamic}</i>",
        "player-icons": {
            "default": "󰐊",
            "spotify": "",
            "firefox": "󰈹",
            "mpv": "󰎆"
        },
        "status-icons": {
            "paused": "󰏤"
        },
        "dynamic-order": ["title", "artist"],
        "dynamic-len": 26,
        "dynamic-importance-order": ["title", "artist"],
        "dynamic-separator": " • ",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "tooltip-format": "{player}: {title} - {artist} ({album})"
    },

    // ==========================================
    // Center Modules
    // ==========================================
    "clock": {
        "interval": 30,
        "format": "  {:%I:%M %p}",
        "format-alt": "  {:%I:%M:%S %p  󰃭 %A, %d %B %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#cdd6f4'><b>{}</b></span>",
                "days": "<span color='#bac2de'>{}</span>",
                "weeks": "<span color='#94e2d5'><b>W{}</b></span>",
                "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
                "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "hyprland/language": {
        "format": "󰌌  {}",
        "format-en": "US",
        "tooltip": true,
        "tooltip-format": "Active Layout: {long}\n\n• Left Click: Switch Next Layout\n• Right Click: Keyboard Layout Menu\n• Middle Click: Add New Layout",
        "on-click": "/home/kunal/.config/hypr/scripts/keyboard_layout.py --next",
        "on-click-right": "/home/kunal/.config/hypr/scripts/keyboard_layout.py --menu",
        "on-click-middle": "/home/kunal/.config/hypr/scripts/keyboard_layout.py --add-menu"
    },

    // ==========================================
    // Right Modules
    // ==========================================
    "group/tray-notif": {
        "orientation": "horizontal",
        "modules": [
            "tray",
            "custom/clipboard",
            "custom/notification"
        ]
    },

    "group/status": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio",
            "backlight",
            "network",
            "bluetooth",
            "custom/battery"
        ]
    },

    "custom/stats": {
        "format": "󰍛",
        "tooltip": true,
        "tooltip-format": "<b>System Hardware &amp; Stats</b>\n• Left Click: Open Stats Dashboard\n• Right Click: Launch Btop Task Monitor",
        "on-click": "/home/kunal/.config/waybar/scripts/system-stats.py",
        "on-click-right": "kitty --class btop -e btop"
    },

    "group/hardware": {
        "orientation": "horizontal",
        "modules": [
            "cpu",
            "memory",
            "temperature",
            "disk"
        ]
    },

    "cpu": {
        "interval": 2,
        "format": "󰍛 {usage}%",
        "tooltip": true,
        "tooltip-format": "CPU Usage: {usage}%\nCores: {cores}",
        "on-click": "kitty --class btop -e btop"
    },

    "memory": {
        "interval": 5,
        "format": "󰘚 {percentage}%",
        "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)\nSwap: {swapUsed:0.1f}GiB / {swapTotal:0.1f}GiB",
        "on-click": "kitty --class btop -e btop"
    },

    "temperature": {
        "interval": 5,
        "thermal-zone": 7,
        "critical-threshold": 80,
        "format": "󰔏 {temperatureC}°C",
        "format-critical": "󰔏 {temperatureC}°C",
        "tooltip": true,
        "tooltip-format": "Temperature: {temperatureC}°C"
    },

    "disk": {
        "interval": 30,
        "format": "󰋊 {percentage_used}%",
        "path": "/",
        "tooltip-format": "Disk: {used} / {total} used ({percentage_used}%) on {path}",
        "on-click": "kitty --hold -e df -h /"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "󰂰 {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋋",
            "headset": "󰋋",
            "phone": "󰏲",
            "portable": "󰏲",
            "car": "󰄋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 5,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle || pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "/home/kunal/.config/waybar/scripts/sound-menu.sh",
        "on-click-middle": "/home/kunal/.config/waybar/scripts/sound-menu.sh --tui",
        "tooltip-format": "{desc} | Volume: {volume}%"
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "scroll-step": 5,
        "on-scroll-up": "/home/kunal/.config/waybar/scripts/brightness-menu.sh --up 5",
        "on-scroll-down": "/home/kunal/.config/waybar/scripts/brightness-menu.sh --down 5",
        "on-click": "/home/kunal/.config/waybar/scripts/brightness-menu.sh",
        "on-click-right": "/home/kunal/.config/waybar/scripts/brightness-menu.sh --nightlight",
        "on-click-middle": "/home/kunal/.config/waybar/scripts/brightness-menu.sh --tui",
        "tooltip-format": "Display Brightness: {percent}%\n\n• Scroll: Adjust Brightness (±5%)\n• Left Click: Display & Brightness Sliders\n• Right Click: Toggle Night Light\n• Middle Click: Interactive TUI Mixer"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-on": "󰂯",
        "format-connected": "󰂱 {num_connections}",
        "format-connected-battery": "󰂱 {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "tooltip-format-disabled": "Bluetooth is disabled / off",
        "tooltip-format-off": "Bluetooth is turned off",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "󰂱 {device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "󰂱 {device_alias}\t{device_address}\t({device_battery_percentage}%)",
        "on-click": "/home/kunal/.config/waybar/scripts/bluetooth-menu.sh",
        "on-click-right": "rfkill toggle bluetooth"
    },

    "network": {
        "interval": 5,
        "format-wifi": "󰤨 {signalStrength}%",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "󰤨  {essid} ({signalStrength}%)\n⇣ {bandwidthDownBytes}   ⇡ {bandwidthUpBytes}\nIP: {ipaddr}/{cidr}",
        "tooltip-format-ethernet": "󰈀  {ifname}\n⇣ {bandwidthDownBytes}   ⇡ {bandwidthUpBytes}\nIP: {ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "/home/kunal/.config/waybar/scripts/network-menu.sh"
    },

    "custom/battery": {
        "format": "{}",
        "return-type": "json",
        "exec": "/home/kunal/.config/waybar/scripts/battery-status.py",
        "on-click-right": "/home/kunal/.config/waybar/scripts/power-profile.py",
        "on-click": "/home/kunal/.config/waybar/scripts/power-profile.py",
        "interval": 30,
        "signal": 8,
        "tooltip": true
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "custom/clipboard": {
        "format": "{}",
        "return-type": "json",
        "exec-if": "command -v cliphist",
        "exec": "/home/kunal/.config/hypr/scripts/clipboard_manager.py --status",
        "on-click": "/home/kunal/.config/hypr/scripts/clipboard_manager.py --menu",
        "on-click-right": "/home/kunal/.config/hypr/scripts/clipboard_manager.py --delete",
        "on-click-middle": "/home/kunal/.config/hypr/scripts/clipboard_manager.py --toggle-pause",
        "interval": 30,
        "signal": 9,
        "tooltip": true
    },

    "custom/notification": {
        "format": "{}",
        "return-type": "json",
        "exec-if": "command -v makoctl",
        "exec": "/home/kunal/.config/waybar/scripts/notifications.py --status",
        "on-click": "/home/kunal/.config/waybar/scripts/notifications.py",
        "on-click-right": "/home/kunal/.config/waybar/scripts/notifications.py --toggle-dnd",
        "on-click-middle": "/home/kunal/.config/waybar/scripts/notifications.py --clear",
        "interval": 30,
        "signal": 10,
        "tooltip": true
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip": true,
        "tooltip-format": "Power / Session Menu",
        "on-click": "/home/kunal/.config/waybar/scripts/power-menu.sh"
    }
}

[Desktop Entry]
Version=1.0
Type=Application
Name=Audio & Volume Menu
GenericName=Audio Device & Volume Selector
Comment=Select default audio outputs/inputs and adjust volume via interactive menu
Exec=python3 /home/kunal/.config/hypr/scripts/volume_control.py
Icon=audio-volume-high
Terminal=false
Categories=Utility;AudioVideo;Audio;Settings;
StartupWMClass=volume-control
StartupNotify=true
Keywords=volume;audio;sound;pipewire;wireplumber;sink;source;microphone;speaker;
Actions=MuteToggle;MicMuteToggle;VolumeUp;VolumeDown;

[Desktop Action MuteToggle]
Name=Toggle Output Mute
Exec=python3 /home/kunal/.config/hypr/scripts/volume_control.py mute

[Desktop Action MicMuteToggle]
Name=Toggle Microphone Mute
Exec=python3 /home/kunal/.config/hypr/scripts/volume_control.py mic-mute

[Desktop Action VolumeUp]
Name=Volume Up (+5%)
Exec=python3 /home/kunal/.config/hypr/scripts/volume_control.py up 5

[Desktop Action VolumeDown]
Name=Volume Down (-5%)
Exec=python3 /home/kunal/.config/hypr/scripts/volume_control.py down 5

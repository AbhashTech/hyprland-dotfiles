# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Caches and temporary logs
*.tmp
*.log
.cache/
.DS_Store

# Backups created during installation
*.bak
*.backup

# User local runtime state
.config/hypr/ocr_config.json
.config/hypr/recorder_settings.json
.config/quickshell/colors.json
.config/quickshell/custom_plugins/*
!.config/quickshell/custom_plugins/README.md
.config/quickshell/.generated/
.config/quickshell/generated/

# Modular User Personal Configurations (Self-descriptive & Untracked)
.config/hypr/user/*
!.config/hypr/user/README.md
.config/shell/user/*
!.config/shell/user/README.md
.config/shell/*.local.sh
.config/nvim/lua/plugins/personal_*.lua
.config/nvim/lua/custom/*
!.config/nvim/lua/custom/README.md



